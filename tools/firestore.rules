rules_version = '2';
// Journal comments (see site.comments in tools/data.mjs).
// Anyone may read comments and add one (a name and a note, size-limited).
// Nobody can edit or delete from the website; remove comments in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{slug}/comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text'])
        && request.resource.data.keys().hasAll(['name', 'text'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }
  }
}
